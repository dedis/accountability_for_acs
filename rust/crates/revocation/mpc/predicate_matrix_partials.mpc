# predicate_matrix_partials.mpc
#
# Compile: ./compile.py predicate_matrix_partials <N> <tau>
#
# Inputs (Player 0 only; canonical upper-triangle order):
#   per pair (i,j) with i < j:
#     M'.x, M'.y    (pre-computed in JS as fullDecryptedC3Diffs[i][j])
#
# The zero test on the special values (0,1) survives the field mismatch
# between MP-SPDZ's sint prime and BabyJubjub's BN254 base prime.

from Compiler.types import sint, cint
from Compiler.library import print_ln

N   = int(program.args[1])
TAU = int(program.args[2])

# Shared symmetric N×N bit matrix B with B[i][i] = 1 (self-match).
B = [[None] * N for _ in range(N)]
for i in range(N):
    B[i][i] = cint(1)

for i in range(N):
    for j in range(i + 1, N):
        Mx = sint.get_input_from(0)
        My = sint.get_input_from(0)
        is_x_zero = (Mx == 0)
        is_y_one  = (My == 1)
        b = is_x_zero * is_y_one
        B[i][j] = b
        B[j][i] = b

for i in range(N):
    count_i = B[i][0]
    for j in range(1, N):
        count_i = count_i + B[i][j]
    predicate = (count_i >= TAU).reveal()
    print_ln("row_%s=%s", i, predicate)
